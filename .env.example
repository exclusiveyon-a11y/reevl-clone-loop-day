# 변수 이름만 적는다. 값은 이 저장소에 두지 않는다.
# 실행 시 환경 변수 → REEVL_ENV 파일(리블 본체 .env) 순서로 필요한 이름 하나씩만 읽는다.

# 리블 본체 .env 경로 (기본 ~/reevl/.env)
REEVL_ENV=
# 리블 공개 MCP API (기본 https://reevl.co.kr/api/mcp, 인증 없음)
REEVL_MCP_URL=

# 네이버 검색 API (카페글·지식iN·블로그)
# 1순위: NAVER API HUB(네이버 클라우드) 키 — naverapihub.apigw.ntruss.com, 하루 호출 상한 GTM_NAVER_DAILY_CAP(기본 300)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
GTM_NAVER_DAILY_CAP=
# 2순위: 네이버 개발자센터 키 — openapi.naver.com (검색 권한이 있는 앱일 때)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 카카오 다음 검색 API (카페·웹문서·블로그)
KAKAO_REST_API_KEY=

# 로컬 파일 위치 (저장소에 올리지 않는다)
GTM_QUEUE=
GTM_HUB_CACHE=

# 측정 (analysis/ga_report.py, 읽기 전용 서비스 계정)
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=
